+    incoming, accepted = sys.argv[2:4]
+    checked_archive(incoming)
+    # Same-directory rename accepts the complete source in one operation.
+    print('ACCEPTING %s' % accepted, flush=True)
+    os.replace(incoming, accepted)
+    sys.exit(0)
