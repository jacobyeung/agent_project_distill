+    with open(flagout, 'w') as f:
+        f.write(''.join(x + '\n' for x in flags))
+    print('SCAN scanned=%d copied=%d unchanged=%d flagged=%d list=%s' % (scanned, copied, same, len(flags), flagout))
+    for x in flags[:50]:
+        print('FLAG ' + x)
+
