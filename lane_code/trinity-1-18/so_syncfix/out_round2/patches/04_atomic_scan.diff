+    def test_special_entries_and_truncated_archives_preserve_accepted(self):
+        for kind in ('fifo', 'symlink', 'hardlink', 'character', 'parent', 'absolute', 'truncated'):
+            with self.subTest(kind=kind):
+                incoming = self.root / ('incoming-' + kind)
