+def check(state_root, events, log, now):
+    health = state_root / 'health'
+    health.mkdir(parents=True, exist_ok=True)
+    events.mkdir(parents=True, exist_ok=True)
+    with (health / '.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
