+    base = Path(os.environ.get('LCS_B', '/data2/jjyeung/agent_project_data/distillation_orchestrator_20260918/orch_n30'))
+    events = Path(os.environ.get('LCS_EV', str(base / 'events' / 'code_sync'))).resolve()
