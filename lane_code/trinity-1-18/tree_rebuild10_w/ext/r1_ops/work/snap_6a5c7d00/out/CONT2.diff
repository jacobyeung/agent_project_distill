+
+    def test_derived_code_directories_are_sealed(self):
+        for kit in [self.kit, *map(Path, load(ROOT/'out/proof/DERIVATION.json')['fixture_paths'])]:
+            directories = [kit/'b', *(p for p in (kit/'b').rglob('*') if p.is_dir())]
