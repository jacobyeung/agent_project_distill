+class ZContinuationModes(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.kit = Path(load(ROOT/'out/proof/PRE_SUBMISSION.json')['fixture'])/'ready'
+        spec = importlib.util.spec_from_file_location('proof_c2', ROOT/'out/proof/p.py')
