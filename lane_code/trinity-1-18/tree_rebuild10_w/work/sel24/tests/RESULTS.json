  "create_sql": [
    "CREATE TABLE candidates (k INTEGER PRIMARY KEY, qid TEXT NOT NULL, question_type TEXT NOT NULL, origin TEXT NOT NULL, source TEXT NOT NULL, row TEXT NOT NULL)",
    "CREATE INDEX candidate_qids ON candidates(qid,origin)",
    "CREATE INDEX candidate_order ON candidates((origin='legacy'),k)",
    "CREATE TABLE pool_qids (qid TEXT PRIMARY KEY)",
    "CREATE TABLE membership (i INTEGER PRIMARY KEY,k INTEGER UNIQUE NOT NULL)",
    "CREATE VIEW rows AS SELECT m.i,c.row,'{}' AS target FROM membership m JOIN candidates c ON c.k=m.k"
