+        pose = {**copy.deepcopy(shuffled[0]), 'category': samples.CATEGORY, 'pose_sample': dict(augment={})}
+        with patch.object(samples, 'check_sample'), self.assertRaisesRegex(ValueError, 'pose rows'):
+            self.donor_batch(pose, block['gf1'])
