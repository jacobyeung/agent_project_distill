+def diff(a, b):
+    a, b = a.float(), b.float()
+    scale = float(b.abs().max())
+    absolute = float((a - b).abs().max())
+    return dict(max_abs=absolute, max_rel=absolute / max(scale, 1e-30), ref_max=scale)
