+def host_root():
+    out = []
+    for name in sorted(os.listdir('/')):
+        if name in ('proc', 'dev', 'tmp', 'scratch'): continue
+        p = '/' + name
+        if os.path.islink(p): out += ['--symlink', os.readlink(p), p]
+        elif os.path.isdir(p): out += ['--ro-bind', p, p]
+    return out
