+        v=Qwen3_5VisionModel().eval().requires_grad_(False)
+        cache=C.ReadCache(1000000);C.install_vision_cache(types.SimpleNamespace(model=types.SimpleNamespace(visual=v)),cache)
+        with torch.no_grad():
