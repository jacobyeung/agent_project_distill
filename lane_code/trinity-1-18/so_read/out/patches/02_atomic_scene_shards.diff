+def shard(value):
+    try:
+        i, n = map(int, value.split('/'))
+        if n < 1 or not 0 <= i < n:raise ValueError()
+    except (ValueError, TypeError):
+        raise ValueError('--shard must be zero-based i/n, with 0 <= i < n')
+    return i, n
+
