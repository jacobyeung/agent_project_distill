+if action==0:
+    from orchard_h10.prepare import run
+    run(cfg['config'],cfg['inputs'])
+elif action==1:
+    import os
+    from orchard_h10.runner import run
+    result=run(cfg['config'],os.environ['CUDA_VISIBLE_DEVICES'].split(','),cfg['end'],prefix=cfg['config']['prefix'])
