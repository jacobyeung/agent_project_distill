+    if len(lines) != 1:
+        raise ValueError('A4 batch encoding differs')
+    files = unpack(bytes.fromhex(ast.literal_eval(lines[0][len('b=bytes.fromhex('):-1])))
+    if set(files) != {'0.py', '7.py', '0.json'}:
