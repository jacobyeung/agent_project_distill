+    if 'types' in inputs:
+        types=inputs['types']
+        if (not isinstance(types,list) or not types
+                or any(not isinstance(kind,str) or kind not in ORDER for kind in types)
+                or types!=[kind for kind in ORDER if kind in types]):
+            raise ValueError('Invalid type selection')
