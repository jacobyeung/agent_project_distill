+        assert task['frame_paths'] == [f['path'] for f in c['frames']]
+        b = parity.bind_item(task, settings, verify=False)
+        mapped[item['id']] = task
+        mapping.append(dict(id=item['id'], key=parity.key(task), native=task['native'],
