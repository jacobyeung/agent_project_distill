+def shell_python(code):
+    return "/usr/bin/python3 -I -s -B - <<'PYCODE'\n"+code+"\nPYCODE\n"
+
+
+def shell_header():
+    return ('set -euo pipefail\numask 077\n'
+            "trap 'r=$?; if [ \"$r\" -ne 0 ]; then printf \"phase failed: exit %s line %s\\n\" \"$r\" \"$LINENO\" >&2; fi' EXIT\n")
