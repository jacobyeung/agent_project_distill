+                        with self.assertRaises(sqlite3.ProgrammingError):
+                            rows._c1_cpu_producer.rows.mixes['pose'].sources[0].conn.execute('SELECT 1')
+                finally:
+                    rows.close()
+        assert_nested(self,*results)
