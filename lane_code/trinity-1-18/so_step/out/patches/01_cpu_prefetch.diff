+
+    def test_one_group_lookahead_and_exception_deferred_to_its_boundary(self):
+        torch.set_num_threads(8)
+        receipt = inputs(root())
+        model = native()
+        original = run.Rows.get
+        future_failed = threading.Event()
+        calls = []
+        def get(rows,stream,index):
+            calls.append((stream,index))
