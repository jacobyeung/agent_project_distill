{
  "vla": {
    "backbone": {
      "kind": "base",
      "train": "full",
      "vision": "frozen"
    },
    "cond": "none",
    "control_only": true,
    "head": {
      "action_dim": 3,
      "chunk": 8,
      "tokens": {
        "codec": "nav_text"
      },
      "type": "tokens"
    },
    "input": {
      "cameras": [
        "rgb"
      ],
      "history_frames": 32,
      "image_px": 512,
      "proprio": false
    },
    "nav": {
      "eval": {
        "click_backend": null,
        "early_positions": [
          0,
          199
        ],
        "primary_list": "val_unseen_600_s0",
        "range_source": null,
        "step_cap": 500,
        "success_radius_m": 3.0
      },
      "shake_down": {
        "claim": false,
        "steps": 250
      },
      "train": {
        "batch_size": 32,
        "episodes": 1082,
        "exports": [
          250,
          500,
          1000
        ],
        "steps": 1000,
        "subset_seed": 0,
        "warmup_fraction": 0.03
      }
    },
    "prompt": {
      "template": "native_thinking"
    },
    "schema": "vla_schema_v2"
  }
}
