+class Tokenizer:
+    """Synthetic only: </think> is one token; other characters map reversibly."""
+    def encode(self, text, add_special_tokens=False):
+        ids = []
+        while text:
+            if text.startswith('</think>'):
+                ids.append(1); text=text[8:]
+            else:
