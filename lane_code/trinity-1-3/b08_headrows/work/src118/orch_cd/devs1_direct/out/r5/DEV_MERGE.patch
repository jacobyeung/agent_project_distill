+def inventory(kit):
+    return {str(p.relative_to(kit/'evaluator')):A.sha(p)
+            for sub in ('','evalpath','trainer') for p in sorted((kit/'evaluator'/sub).iterdir())
+            if p.is_file() and p.suffix in ('.py','.json')}
