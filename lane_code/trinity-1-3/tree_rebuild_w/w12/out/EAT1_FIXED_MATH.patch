+class FixedMathContract(unittest.TestCase):
+    def make(self):
+        import torch
+        from torch import nn
+        from eat1.artifact import Artifact, write_manifest
+        class Math(nn.Module):
+            def __init__(self):
+                super().__init__()
+                self.register_buffer('scale', torch.tensor(2., dtype=torch.float64))
+            def forward(self, value):
+                return value * self.scale
+        model = nn.Module()
+        model.math = Math()
+        root = Path(tempfile.mkdtemp())
+        torch.save(model.state_dict(), root/'buffers.pt')
+        write_manifest(root/'ARTIFACT.json', root, {'buffers.pt': 'head'}, {
+            'math': dict(role='fixed_math', inputs=['value'], outputs=['scaled'],
+                         buffers={'scale': dict(file='buffers.pt', key='math.scale')})})
+        return model, Artifact(root/'ARTIFACT.json')
+
+    def test_valid_fixed_math(self):
+        import torch
+        model, art = self.make()
+        self.assertEqual(art.module_roles(model)[0][2], 'fixed_math')
+        self.assertEqual(float(model.math(torch.tensor(3.))), 6.)
+        self.assertEqual(R.judge_a1([], art, [])['status'], 'PASS')
+
+    def test_parameter_refuses(self):
+        import torch
+        model, art = self.make()
+        model.math.extra = torch.nn.Parameter(torch.ones(1), requires_grad=False)
+        with self.assertRaisesRegex(ValueError, 'zero parameters'):
+            art.module_roles(model)
+
+    def test_changed_buffer_fails_a1(self):
+        model, art = self.make()
+        model.math.scale.fill_(3.)
+        art.module_roles(model)
+        result = R.judge_a1([], art, [])
+        self.assertEqual(result['status'], 'FAIL')
+        self.assertEqual(result['offenders'][0]['kind'], 'fixed_math_buffer_mismatch')
+
+    def test_buffer_mutation_during_generate_fails_a1(self):
+        from types import SimpleNamespace
+        model, art = self.make()
+        def generate(frames, question):
+            model.math.scale.fill_(7.)
+            return dict(text='7', answer='7', calls=[])
+        reader = SimpleNamespace(model=model, generate=generate)
+        records, lines, declared = R.observe(reader, [dict(frames='fixture', question='fixture')], art,
+            trace_lines=False, audit=False, monitor=False)
+        self.assertIsNone(records[0]['error'])
+        self.assertEqual(R.judge_a1(records, art, [])['status'], 'FAIL')
+        self.assertEqual(art.buffer_offenders[0]['kind'], 'fixed_math_buffer_mismatch')
+
