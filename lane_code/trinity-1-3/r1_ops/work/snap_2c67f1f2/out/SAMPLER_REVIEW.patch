+def room_trace(row):
+    """Recognize the reviewed Seen/relation/answer grammar, with pinned citations."""
+    if row.get('pool') != 'r1_room_traced':return False
+    text=row.get('target','')
+    if not isinstance(text,str):return False
+    match=re.fullmatch(r'\s*<think>\s*(.*?)\s*</think>\s*([+-]?(?:\d+(?:\.\d*)?|\.\d+))\s*',text,re.S)
+    if not match:return False
+    think=match[1];lines=[line.strip() for line in think.splitlines() if line.strip()]
+    seen=[i for i,line in enumerate(lines) if line.startswith('Seen:')]
+    if not seen:return False
+    # The optional question restatement precedes the observations; one relation follows.
+    if any(not line.startswith('The question asks ') for line in lines[:seen[0]]):return False
+    if seen!=list(range(seen[0],seen[-1]+1)) or len(lines)!=seen[-1]+2:return False
+    relation=lines[-1]
+    if not re.search(r'\b(?:apart|between|side|left|right|opposite|near|behind|front|across)\b',relation,re.I):return False
+    frames=row.get('student_input',{}).get('frames',[])
+    for i in seen:
+        cites=re.findall(r'\bframe\s+(\d+)\b',lines[i],re.I)
+        if not cites or any(not 1<=int(n)<=len(frames) for n in cites):return False
+        for n in cites:
+            pin=frames[int(n)-1]
+            if not isinstance(pin,dict) or not isinstance(pin.get('path'),str) or not pin['path'] or not isinstance(pin.get('sha256'),str) or not re.fullmatch('[0-9a-fA-F]{64}',pin['sha256']):return False
+    # Only Seen citations may print numbers; reject spelled-out measurements as well.
+    qualitative='\n'.join(re.sub(r'\bframe\s+\d+\b','frame',line,flags=re.I) if i in seen else line for i,line in enumerate(lines))
+    if re.search(r'\d|\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|hundred|thousand|million|half|quarter)\b',qualitative,re.I):return False
+    if re.search(r'\b(?:length|width|height|area)\s*(?:is|=|:|of)\s*(?:about|approximately|roughly)?\s*\d',qualitative,re.I):return False
+    return True
