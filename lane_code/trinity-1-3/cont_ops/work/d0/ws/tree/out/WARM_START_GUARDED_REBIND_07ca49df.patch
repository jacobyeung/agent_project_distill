+import copy
+from pathlib import Path
+import re
+
+from .p3_provenance import digest, load, pinned
+
+
+REBUILT = ('pointing', 'routing', 'vqa')
+EXECUTION = ('config_sha256', 'trainer_commit', 'source_seal')
+PIN_FIELDS = ('path', 'sha256')
+
+
+def pin_fields(prefix, content=True):
+    return {prefix + (key,) for key in PIN_FIELDS if content or key == 'path'}
+
+
+def preparation_allowlist():
+    allowed = pin_fields(('native_preparation',))
+    for name in REBUILT:
+        for prefix in (('streams', name), ('streams', name, 'scene_source')):
+            for key in ('database', 'indices', 'receipt'):
+                allowed.update(pin_fields(prefix + (key,)))
+        allowed.update(pin_fields(('scene_filter_report', 'expected', name, 'population', 'database')))
+    for prefix in (('streams', 'pose'), ('streams', 'pose', 'scene_source')):
+        allowed.update(pin_fields(prefix + ('order',)))
+        for key in ('receipt', 'database', 'division'):
+            allowed.update(pin_fields(prefix + (key,), False))
+        for i in ('0', '1'):
+            for key in ('receipt', 'database', 'division'):
+                allowed.update(pin_fields(prefix + ('sources', i, key), False))
+    for key in (('model',), ('division',), ('camera', 'supervision')):
+        allowed.update(pin_fields(key, False))
+    allowed.update(pin_fields(('scene_filter_report', 'upstream', 'routing', 'expected', '@pool', 'reference')))
+    return allowed
+
+
+def stream_allowlist(name):
+    allowed = pin_fields(('database',), name in REBUILT)
+    for key in (('model',), ('division',), ('camera', 'supervision')):
+        allowed.update(pin_fields(key, False))
+    if name == 'routing':
+        allowed.update(pin_fields(('materialization',)))
+        allowed.update(pin_fields(('source_scene_exclusions', 'expected', '@pool', 'reference')))
+    if name == 'pose':
+        for i in ('0', '1'):
+            allowed.update(pin_fields(('sources', i, 'receipt'), False))
+    return allowed
+
+
+def permitted(path, allowed):
+    return any(len(path) == len(pattern) and all(
+        expected == actual or expected == '@pool' and actual.startswith('pool/')
+        for actual, expected in zip(path, pattern)) for pattern in allowed)
+
+
+def compare(before, after, allowed, scope, path=()):
+    if type(before) is not type(after):
+        raise ValueError('Warm preparation settings differ in type: ' + scope + '/' + '/'.join(path))
+    if isinstance(before, dict):
+        if before.keys() != after.keys():
+            raise ValueError('Warm preparation settings differ in fields: ' + scope + '/' + '/'.join(path))
+        for key in before:
+            compare(before[key], after[key], allowed, scope, path + (key,))
+    elif isinstance(before, list):
+        if len(before) != len(after):
+            raise ValueError('Warm preparation settings differ in length: ' + scope + '/' + '/'.join(path))
+        for i, (left, right) in enumerate(zip(before, after)):
+            compare(left, right, allowed, scope, path + (str(i),))
+    elif before != after:
+        if not permitted(path, allowed):
+            raise ValueError('Warm preparation settings differ: ' + scope + '/' + '/'.join(path))
+        if path[-1] == 'path':
+            if not isinstance(after, str) or not Path(after).is_absolute() or '..' in Path(after).parts:
+                raise ValueError('Warm rebuilt pin has an invalid path')
+        elif not isinstance(after, str) or not re.fullmatch('[0-9a-f]{64}', after):
+            raise ValueError('Warm rebuilt pin has an invalid SHA256')
+
+
+def execution_stamp(receipt):
+    seal = receipt.get('source_seal')
+    if not isinstance(seal, dict):
+        raise ValueError('Warm preparation requires a source/configuration binding')
+    body = {key: value for key, value in seal.items() if key != 'sha256'}
+    if (set(body) != {'schema', 'tree_sha256', 'config_sha256', 'archive'}
+            or body['schema'] != 's1-run-seal-v1' or seal['sha256'] != digest(body)
+            or body['config_sha256'] != receipt.get('config_sha256')
+            or 'trainer_commit' in receipt and receipt['trainer_commit'] != 'sha256:' + body['tree_sha256']):
+        raise ValueError('Warm preparation execution provenance is malformed')
+
+
+def effective_before(receipt, cfg):
+    value = copy.deepcopy(receipt)
+    value.update(align=cfg.get('align'), frame_markers=cfg.get('frame_markers', False),
+                 pointing_weights=cfg.get('pointing_weights'),
+                 camera={**value.get('camera', {}), **cfg.get('camera_overrides', {})})
+    return value
+
+
+def consistent_pins(receipt, cfg):
+    if {name: value['receipt'] for name, value in receipt['streams'].items()} != cfg['streams']:
+        raise ValueError('Warm stream pins differ from the effective configuration')
+    for name, value in receipt['streams'].items():
+        prior = value.get('scene_source', value)
+        for key in ('receipt', 'database'):
+            if key in prior and key in value and prior[key] != value[key]:
+                raise ValueError('Warm stream aliases disagree on their pinned source')
+        expected = receipt.get('scene_filter_report', {}).get('expected', {}).get(name, {}).get('population', {})
+        if 'database' in expected and expected['database'] != value.get('database'):
+            raise ValueError('Warm scene census disagrees with its stream database')
+
+
+def check(before, donor, receipt, cfg):
+    if list(before['streams']) != list(receipt['streams']):
+        raise ValueError('Warm preparation settings differ in stream order')
+    if receipt.get('init_artifact') != cfg['init_artifact']:
+        raise ValueError('Warm preparation init differs from the selected export')
+    for value, config in ((before, donor), (receipt, cfg)):
+        execution_stamp(value)
+        consistent_pins(value, config)
+    old = effective_before(before, donor)
+    new = copy.deepcopy(receipt)
+    for key, default in (('align', None), ('frame_markers', False), ('pointing_weights', None)):
+        new.setdefault(key, default)
+    for key in EXECUTION:
+        if (key in old) != (key in new):
+            raise ValueError('Warm preparation execution fields are missing')
+        old.pop(key, None)
+        new.pop(key, None)
+    for key in ('init_artifact', 'warm_start'):
+        old.pop(key, None)
+        new.pop(key, None)
+    compare(old, new, preparation_allowlist(), 'prepared')
+    for name in before['streams']:
+        current = load(pinned(cfg['streams'][name]))
+        previous = current if donor['streams'][name]['sha256'] == cfg['streams'][name]['sha256'] else load(
+            pinned(donor['streams'][name]))
+        compare(previous, current, stream_allowlist(name), 'stream/' + name)
