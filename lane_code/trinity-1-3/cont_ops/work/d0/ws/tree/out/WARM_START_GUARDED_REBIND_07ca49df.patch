+import hashlib
+import json
+from pathlib import Path
+import sqlite3
+
+from .p3_provenance import digest, load, pinned
+
+
+SCHEMA = 's1-ordered-row-content-v1'
+ATTESTATION = 's1-donor-row-order-v1'
+
+
+def canonical(value):
+    if isinstance(value, dict):
+        if set(value) == {'path', 'sha256'}:
+            return {'sha256': value['sha256']}
+        return {key: canonical(part) for key, part in value.items()}
+    if isinstance(value, list):
+        return [canonical(part) for part in value]
+    return value
+
+
+def fingerprint(receipt):
+    streams = receipt['streams']
+    if set(streams) != {'pointing', 'pose', 'routing', 'vqa'}:
+        raise ValueError('Ordered-row identity requires the four admitted streams')
+    connections, signatures = {}, []
+
+    def database(pin):
+        key = (pin['path'], pin['sha256'])
+        if key not in connections:
+            path = pinned(pin)
+            if Path(str(path) + '-wal').exists() or Path(str(path) + '-journal').exists():
+                raise ValueError('Ordered-row identity requires closed immutable databases')
+            connections[key] = sqlite3.connect(path.as_uri() + '?mode=ro&immutable=1', uri=True)
+        return connections[key]
+
+    try:
+        for name, value in streams.items():
+            count = value['count']
+            if type(count) is not int or count < 1:
+                raise ValueError('Ordered-row identity requires a positive integer count')
+            if value.get('kind') == 'mix':
+                order = load(pinned(value['order']))
+                sources = value['sources']
+                if any(part.get('kind') != 'rows' for part in sources):
+                    raise ValueError('This donor-order schema supports database pose sources only')
+            else:
+                indices = load(pinned(value['indices'])) if 'indices' in value else range(count)
+                order, sources = [(0, index) for index in indices], [value]
+            if len(order) != count:
+                raise ValueError('Ordered-row mapping length differs from the admitted count')
+            h = hashlib.sha256()
+            for pair in order:
+                if (not isinstance(pair, (list, tuple)) or len(pair) != 2
+                        or any(type(index) is not int or index < 0 for index in pair)
+                        or pair[0] >= len(sources)):
+                    raise ValueError('Ordered-row mapping contains an invalid database index')
+                part, index = pair
+                row = database(sources[part]['database']).execute(
+                    'SELECT row,target FROM rows WHERE i=?', (index,)).fetchone()
+                if row is None:
+                    raise ValueError('Ordered-row mapping names a missing row')
+                payload = json.dumps(canonical([json.loads(row[0]), json.loads(row[1])]),
+                                     sort_keys=True, separators=(',', ':'), allow_nan=False).encode()
+                h.update(len(payload).to_bytes(8, 'big'))
+                h.update(payload)
+            signatures.append(dict(name=name, count=count, sha256=h.hexdigest()))
+    finally:
+        for connection in connections.values():
+            connection.close()
+    value = dict(schema=SCHEMA, streams=signatures)
+    return {**value, 'sha256': digest(value)}
+
+
+def snapshot(config_pin):
+    from .carrier_c1_run import identity
+
+    cfg = load(pinned(config_pin))
+    receipt = load(pinned(cfg['preparation']))
+    if receipt.get('config_sha256') != identity(cfg):
+        raise ValueError('Donor row attestation requires the effective configuration and its preparation')
+    return dict(schema=ATTESTATION, config=config_pin, preparation=cfg['preparation'], rows=fingerprint(receipt))
+
+
+def verify(attestation_pin, donor_config_pin, donor_preparation_pin, current_receipt):
+    value = load(pinned(attestation_pin))
+    if (set(value) != {'schema', 'config', 'preparation', 'rows'} or value['schema'] != ATTESTATION
+            or value['config'] != donor_config_pin or value['preparation'] != donor_preparation_pin):
+        raise ValueError('Donor ordered-row attestation is not bound to this donor')
+    rows = value['rows']
+    if (not isinstance(rows, dict) or set(rows) != {'schema', 'streams', 'sha256'}
+            or rows['schema'] != SCHEMA
+            or rows['sha256'] != digest({key: part for key, part in rows.items() if key != 'sha256'})):
+        raise ValueError('Donor ordered-row attestation is malformed')
+    if fingerprint(current_receipt) != rows:
+        raise ValueError('Warm ordered row content differs from the donor attestation')
+    return rows['sha256']
