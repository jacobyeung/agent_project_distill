+def validate_composite_role_policy(
+    composite: Mapping[str, Any],
+    policy: Mapping[str, Any],
+    resolve: Callable[[str], Mapping[str, Any]],
+) -> None:
+    """Cross-check an already-loaded-and-validated composite record against a role's
