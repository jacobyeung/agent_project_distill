+    per_type={t:metrics([r for r in native if r['question_type']==t],[t]) for t in TYPES}
+    subtasks={g:metrics([r for r in native if r['question_type'] in ts],ts) for g,ts in GROUPS.items()}
+    primary=metrics(native,list(TYPES))
