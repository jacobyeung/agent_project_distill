+def _record_path_in_dir(records_dir: Path, record_id: str) -> Path:
+    match = SHA256_RE.fullmatch(record_id)
+    if match is None:
+        raise ScoreIndexError(f"invalid record id {record_id!r}")
+    return records_dir / f"{match.group(1)}.json"
