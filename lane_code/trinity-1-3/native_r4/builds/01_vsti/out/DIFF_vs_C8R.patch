+    for role in VSTI_ROLE_POLICIES:
+        composite = _validate_composite_role(repo_root, role, nominations[role])
+        loaded[role] = {"composite": composite}
+    return {"index": index, "records": loaded, "scorer_id": index["scorer_id"]}
