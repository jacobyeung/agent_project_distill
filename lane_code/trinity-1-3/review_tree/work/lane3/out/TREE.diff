+    def identity(stat):
+        return stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns
+
+    def verify(self, pin):
+        path = resolve_frame(pin['path'])
+        with self.lock:
+            self.requests += 1
+            with path.open('rb') as handle:
+                identity = self.identity(os.fstat(handle.fileno()))
+                value = self.values.get(identity)
+                if value is None:
