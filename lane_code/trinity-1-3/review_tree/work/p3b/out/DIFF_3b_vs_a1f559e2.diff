+def at_scene(row, scene, qid):
+    row = deepcopy(row)
+    row.update(qid=qid, dataset=scene.split('/')[0], scene=scene.split('/')[1], canonical=scene)
+    row.setdefault('provenance', {}).update(canonical=scene, alias=scene)
+    return row
