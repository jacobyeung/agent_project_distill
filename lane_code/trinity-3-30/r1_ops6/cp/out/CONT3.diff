+    out=ROOT/'out';baseline=load(out/'CONT3_BASELINE.json');base=Path(baseline['snapshot'])
+    b=load(out/'BINDING.json');op=load(out/'OPERATOR.json')
+    log=(out/'logs/tests.log').read_text()
