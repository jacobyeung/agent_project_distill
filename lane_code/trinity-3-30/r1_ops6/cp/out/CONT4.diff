+                raise ValueError('Unsafe trainer fixture member')
+            if member.isdir():
+                path.mkdir(parents=True, exist_ok=True, mode=0o700)
+            elif member.isfile():
+                path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+                path.write_bytes(archive.extractfile(member).read())
