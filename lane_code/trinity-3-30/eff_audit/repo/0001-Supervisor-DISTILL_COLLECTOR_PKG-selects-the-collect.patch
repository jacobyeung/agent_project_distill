@@ -0,0 +1,38 @@
+"""DISTILL_COLLECTOR_PKG selects the supervisor's collector package."""
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parents[1]
+
+
+def _pkg(tmp_path, value):
+    env = dict(os.environ, R1315_RUNTIME=str(tmp_path))
+    env.pop('DISTILL_COLLECTOR_PKG', None)
+    if value is not None:
+        env['DISTILL_COLLECTOR_PKG'] = value
+    return subprocess.run(
+        [sys.executable, '-B', '-c', 'import recover_boundary_remediation as r; print(r.PKG)'],
+        cwd=TOOLS, env=env, capture_output=True, text=True)
+
+
+def test_override_points_at_epoch_checkout(tmp_path):
+    epoch = tmp_path / 'epoch' / 'collector'
+    epoch.mkdir(parents=True)
+    (epoch / 'collect.py').write_text('')
+    out = _pkg(tmp_path, str(epoch))
+    assert out.returncode == 0, out.stderr
+    assert out.stdout.strip() == str(epoch.resolve())
+
+
+def test_override_without_collect_py_refuses(tmp_path):
+    out = _pkg(tmp_path, str(tmp_path))
+    assert out.returncode != 0
+    assert 'no collect.py' in out.stderr
+
+
+def test_default_is_repository_collector(tmp_path):
+    out = _pkg(tmp_path, str(TOOLS.parent / 'collector'))
+    assert out.returncode == 0, out.stderr
+    assert out.stdout.strip() == str((TOOLS.parent / 'collector').resolve())
