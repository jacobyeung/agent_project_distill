+        # The unchanged streaming extractor already refuses all links by default.
+        # Only runtime extraction admits symlinks; preflight that seekable archive
+        # to reject hard links without seeking on the frame puller's pipe.
+        if links:reject_hardlinks(stream)
+        return original(stream,destination,step,limit,links=links,strip=strip,overlay=overlay)
