{
  "title": "orchkit-config-v1 header; the family schema named by family types spec",
  "type": "object",
  "required": ["schema", "kit_pins_sha256", "job", "entry", "n_items", "budgets", "records", "spec"],
  "additionalProperties": false,
  "properties": {
    "schema": {"enum": ["orchkit-config-v1"]},
    "family": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
    "kit_pins_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job": {
      "type": "object",
      "required": ["partition", "gpus", "cpus", "mem_gb", "time_limit_s", "signal_s", "nice"],
      "additionalProperties": false,
      "properties": {
        "partition": {"enum": ["general", "advanced", "preempt"]},
        "gpus": {"type": "integer", "minimum": 0, "maximum": 8},
        "cpus": {"type": "integer", "minimum": 1, "maximum": 256},
        "mem_gb": {"type": "integer", "minimum": 1, "maximum": 2048},
        "time_limit_s": {"type": "integer", "minimum": 60, "maximum": 172800},
        "signal_s": {"type": "integer", "minimum": 30, "maximum": 3600},
        "nice": {"type": "integer", "minimum": 0, "maximum": 10000},
        "account": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
        "root_parent": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]*$"},
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$"}
      }
    },
    "entry": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "n_items": {"type": "integer", "minimum": 0},
    "budgets": {
      "type": "object",
      "required": ["return"],
      "properties": {
        "return": {"type": "object", "required": ["max_bytes"],
                   "properties": {"max_bytes": {"type": "integer", "minimum": 1}}},
        "pool": {"type": "object", "required": ["max_bytes"],
                 "properties": {"max_bytes": {"type": "integer", "minimum": 1}}},
        "home": {"type": "object", "required": ["max_bytes"],
                 "properties": {"max_bytes": {"type": "integer", "minimum": 0}}},
        "time": {"type": "object",
                 "properties": {"per_item_s": {"type": "number", "minimum": 0},
                                "fixed_s": {"type": "number", "minimum": 0}}}
      },
      "additionalProperties": {"type": "object"}
    },
    "records": {
      "type": "array",
      "items": {"type": "object", "required": ["logical_path", "sha256"], "additionalProperties": false,
                "properties": {"logical_path": {"type": "string"},
                               "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "spec": {"type": "object"},
    "stage": {
      "type": "array",
      "items": {"type": "object", "required": ["unpack", "dest", "policy"], "additionalProperties": false,
                "properties": {"logical_path": {"type": "string"},
                               "parts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                               "unpack": {"enum": ["file", "tar"]},
                               "dest": {"type": "string"},
                               "policy": {"enum": ["new", "disjoint", "same"]},
                               "members": {"type": "array", "items": {"type": "string"}}}}
    },
    "return": {
      "type": "object", "required": ["pool"], "additionalProperties": false,
      "properties": {"pool": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"},
                     "gcs_prefix": {"type": "string", "pattern": "^gs://[a-z0-9._-]+(/[A-Za-z0-9._/-]*)?$"},
                     "gcs_env": {"type": "object"}}
    }
  }
}
