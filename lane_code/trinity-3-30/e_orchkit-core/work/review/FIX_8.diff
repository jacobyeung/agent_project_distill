+    def test_review_oc24_damaged_prefixed_zip_and_bad_checksum_tar(self):
+        raw = io.BytesIO()
+        with zipfile.ZipFile(raw, 'w', zipfile.ZIP_DEFLATED) as archive:
+            archive.writestr('x', b'qwen')
