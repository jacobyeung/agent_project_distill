@@ -0,0 +1,131 @@
+from pathlib import Path
+import re
+
+from .p3_provenance import digest, load, pinned
+
+
+SCHEMA = 's1-export-warm-start-v1'
+DONOR_RUN = '469ddece'
+DONOR_TREE = 'b01ce449beffe35be3bf0b48ad3d69f331f1523f96a69cbd3d10aab3dbb42a99'
+HEADS = {'pose', 'depth', 'frame_embeddings'}
+REBIND = {'output', 'preparation_output', 'preparation', 'code', 'admission', 'authorization',
+          'milestone_gate', 'streams', 'init_artifact', 'warm_start'}
+
+
+def validate(cfg):
+    if 'warm_start' not in cfg:
+        return
+    value = cfg['warm_start']
+    if not isinstance(value, dict) or set(value) != {'schema', 'donor_config'} or value['schema'] != SCHEMA:
+        raise ValueError('Warm start needs its schema and pinned effective donor configuration')
+    pin = value['donor_config']
+    if (not isinstance(pin, dict) or set(pin) != {'path', 'sha256'}
+            or not isinstance(pin['path'], str) or not Path(pin['path']).is_absolute()
+            or '..' in Path(pin['path']).parts
+            or not isinstance(pin['sha256'], str) or not re.fullmatch('[0-9a-f]{64}', pin['sha256'])):
+        raise ValueError('Warm donor configuration needs an absolute path/SHA256 pin')
+    init = cfg.get('init_artifact', {})
+    if (cfg.get('training_mode') != 'final' or cfg.get('depth_enabled') is not True
+            or set(cfg.get('streams', {})) != {'pointing', 'pose', 'routing', 'vqa'}
+            or set(cfg) & {'mdg', 'geometry_online', 'row_start_step'}
+            or init.get('lm') != 'full' or set(init.get('heads', [])) != HEADS
+            or cfg.get('recipe', {}).get('steps') != 1000 or cfg['recipe'].get('seed') != 17):
+        raise ValueError('Warm continuation is scoped to the four-stream final leg with all heads and no row offset')
+
+
+def content(value):
+    if isinstance(value, dict):
+        if set(value) == {'path', 'sha256'}:
+            return {'sha256': value['sha256']}
+        return {key: content(part) for key, part in value.items() if key != 'receipt'}
+    if isinstance(value, list):
+        return [content(part) for part in value]
+    return value
+
+
+def row_identity(receipt):
+    streams = receipt['streams']
+    if (set(streams) != {'pointing', 'pose', 'routing', 'vqa'}
+            or any(type(value.get('count')) is not int or value['count'] < 1 for value in streams.values())):
+        raise ValueError('Warm row identity needs all four nonempty admitted streams')
+    return digest([[name, content(value)] for name, value in streams.items()])
+
+
+def inherited_names(parent):
+    init = parent.get('head_init') or {}
+    if init.get('prefix') != 'global_camera_head.':
+        return []
+    names = set(init.get('copied', [])) | set(init.get('derived', []))
+    return sorted(name for name in names if name.startswith(
+        ('token_norm.', 'trunk.', 'trunk_norm.', 'pose_modulation.')) or name == 'embed_pose.bias')
+
+
+def bind(cfg, receipt):
+    from .carrier_c1_run import identity, init_mirror
+    from .source_seal import check_export
+
+    validate(cfg)
+    donor_pin = cfg['warm_start']['donor_config']
+    donor = load(pinned(donor_pin))
+    if donor.get('warm_start') is not None or Path(donor['output']).name != DONOR_RUN:
+        raise ValueError('Warm donor must be the original run 469ddece')
+    old_roots = [Path(donor[key]) for key in ('output', 'preparation_output')]
+    new_roots = [Path(cfg[key]) for key in ('output', 'preparation_output')]
+    if (any(not path.is_absolute() or '..' in path.parts for path in old_roots + new_roots)
+            or any(old == new or old in new.parents or new in old.parents
+                   for old in old_roots for new in new_roots)):
+        raise ValueError('Warm destination must use distinct nonoverlapping run and preparation roots')
+    if {key: value for key, value in cfg.items() if key not in REBIND} != {
+            key: value for key, value in donor.items() if key not in REBIND}:
+        raise ValueError('Warm configuration changes the donor training/data policy')
+    before = load(pinned(donor['preparation']))
+    artifact_pin = cfg['init_artifact']['artifact']
+    local = init_mirror(artifact_pin)
+    artifact = load(pinned({**artifact_pin, 'path': str(local / 'artifact.json')}) if local else pinned(artifact_pin))
+    step = artifact.get('step')
+    if type(step) is not int or not 0 < step < cfg['recipe']['steps']:
+        raise ValueError('Warm export step must be an integer inside the unfinished donor horizon')
+    if (artifact.get('schema') != 'carrier-c1-artifact-v1' or artifact.get('training_mode') != 'final'
+            or artifact.get('pose_backing') != 'lm_final_norm'
+            or artifact.get('base_identity') != cfg['base_identity']
+            or artifact.get('placement') != cfg['carrier_placement']
+            or artifact.get('frame_layout', 'spread') != cfg.get('frame_layout', 'spread')
+            or artifact.get('carrier_position_policy', 'native_v1') != 'native_v1'
+            or artifact.get('trace_program_version') != cfg['trace_program_version']
+            or artifact.get('mdg') or artifact.get('geometry_online')):
+        raise ValueError('Warm artifact architecture or training policy differs')
+    if (artifact.get('config_sha256') != identity(donor)
+            or before.get('schema') != 'c1-preparation-v1'
+            or before.get('config_sha256') != identity(donor)
+            or before.get('recipe') != donor['recipe']
+            or before.get('source_seal', {}).get('tree_sha256') != DONOR_TREE
+            or {name: value['receipt'] for name, value in before['streams'].items()} != donor['streams']):
+        raise ValueError('Warm donor configuration, preparation, or source identity differs')
+    check_export(before, artifact)
+    before_rows = row_identity(before)
+    if row_identity(receipt) != before_rows:
+        raise ValueError('Warm admitted row content/order differs from the donor')
+    parent = load(pinned(donor['init_artifact']['artifact']))
+    return dict(schema=SCHEMA, donor_run=DONOR_RUN, donor_config=donor_pin,
+                donor_preparation=donor['preparation'], artifact=artifact_pin, step=step,
+                row_identity_sha256=before_rows, inherited_head_params=inherited_names(parent),
+                optimizer='fresh_adamw', base_precision='bf16_export_to_fp32_trainable_masters',
+                random_state='fresh_seed_not_restored', exact_resume=False)
+
+
+def model_loaded(model, lineage):
+    report = model.init_report
+    if (lineage.get('schema') != SCHEMA or report.get('step') != lineage['step']
+            or report.get('kept') or report.get('planned_init')
+            or report.get('head_tensors') != len(model.auxiliary_heads.state_dict())):
+        raise ValueError('Warm continuation must restore every live head without planned initialization')
+    model.inherited_head_params = lineage['inherited_head_params']
+    model.warm_start_lineage = lineage
+
+
+def start_step(receipt, restored=None):
+    lineage = receipt.get('warm_start')
+    initial = lineage['step'] if lineage else 0
+    if restored is not None and (type(restored) is not int or restored < initial):
+        raise ValueError('Warm-run checkpoint precedes its donor export')
+    return initial if restored is None else restored
