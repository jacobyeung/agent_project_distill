+  trap 'exit 129' HUP
+  trap 'exit 130' INT
+  trap 'exit 143' TERM
+fi
+[[ "$LCS_HOST" =~ ^trinity-[0-9]+-[0-9]+$ ]] || { log "FAIL invalid LCS_HOST: $LCS_HOST"; exit 2; }
+case "$LCS_HOST" in
