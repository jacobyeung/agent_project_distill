+from pathlib import Path
+import hashlib,json,re
+POOL='/project/community/jjyeung/okh7'
+OLD='/project/community/jjyeung/distill/okit'
+MODEL='/project/community/jjyeung/cp4tk_rt/kit/model_qwen35_9b_c2022362.tar'
