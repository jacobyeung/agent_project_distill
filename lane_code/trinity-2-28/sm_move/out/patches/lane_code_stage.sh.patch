 #!/bin/bash
 # Sourced only in robust mode (environment switch or $S/LCS_ROBUST_SYNC file).
 # Each source reuses incoming/accepted tar slots; only complete archives reach SCAN.
+LCS_HOST=${LCS_HOST:-trinity-3-30}
+if ! [[ "$LCS_HOST" =~ ^trinity-[0-9]+-[0-9]+$ ]] ||
+   [[ "$LCS_HOST" =~ ^(trinity|trinity-2-18|trinity-0-8|trinity-0-18|trinity-0-23|trinity-3-23)$ ]]; then
+  echo "REFUSED: invalid or forbidden LCS_HOST: $LCS_HOST" >&2
+  return 2 2>/dev/null || exit 2
+fi
+if [ "$(hostname -s)" != "$LCS_HOST" ]; then
+  echo "REFUSED: staging runs only on $LCS_HOST" >&2
+  return 2 2>/dev/null || exit 2
+fi
 robust_config() {
   export LCS_ROBUST_SYNC=1
   # A regular configuration file lets the owner calibrate the existing tmux loop.
