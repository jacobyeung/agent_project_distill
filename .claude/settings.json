{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin baseline-20260918:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jjyeung/agent_project/agent/scripts/rm_guard.py --hook claude",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow-agent-model-guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
